{
  "manifest_version": 3,
  "name": "KORA — Fulfulde Adamawa",
  "version": "1.4.2",
  "description": "Traduit localement les interfaces financières du français ou de l’anglais vers le fulfulde Adamawa (fub), sans altérer les données.",
  "permissions": ["storage", "activeTab", "scripting"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "KORA",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
