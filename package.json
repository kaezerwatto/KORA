{
  "name": "kora",
  "version": "1.5.0",
  "description": "KORA — traduction financière locale français/anglais vers fulfulde Adamawa (fub)",
  "type": "module",
  "scripts": {
    "build:corpora": "node scripts/index_financial_corpora.mjs",
    "build:terminology": "npm run build:corpora && node scripts/build_corpus_translations.mjs",
    "build": "npm run build:terminology && node scripts/build.mjs",
    "build:icons": "python3 scripts/generate_icons.py",
    "build:model": "npm run build:terminology && python3 scripts/build_fub_language_model.py",
    "model:train": "npm run build:terminology && .venv/bin/python scripts/train_fub_neural_model.py",
    "model:export": "node scripts/export_neural_model.mjs",
    "model:demo": "node scripts/model_demo.mjs",
    "pretest": "npm run build:terminology",
    "test": "node --test tests/engine.test.mjs tests/corpus.test.mjs tests/model-export.test.mjs tests/spelling.test.mjs",
    "test:spelling": "node --test tests/spelling.test.mjs",
    "test:popup": "npm run build && node tests/popup.test.mjs",
    "test:pages": "npm run build && node tests/pages.test.mjs",
    "test:live": "node tests/live.test.mjs",
    "test:uba": "npm run build && node tests/uba-live.test.mjs",
    "test:all": "npm test && npm run test:popup && npm run test:pages && npm run test:live && npm run test:uba",
    "submission:capture": "npm run build && node scripts/capture_submission_assets.mjs",
    "submission:pdf": "node scripts/render_submission_pdf.mjs",
    "submission:voice": "node scripts/generate_elevenlabs_narration.mjs",
    "submission:video": "npm run package && npm run submission:voice && node scripts/record_safinum_demo.mjs",
    "submission:video:preview": "npm run package && KORA_VIDEO_PREVIEW=1 KORA_VIDEO_SPEED=1.8 node scripts/record_safinum_demo.mjs",
    "package": "npm run build && npm run model:export && node scripts/package.mjs"
  },
  "keywords": [
    "chrome-extension",
    "fulfulde",
    "fub",
    "translation",
    "fintech"
  ],
  "author": "KORA",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.17.0"
  }
}
